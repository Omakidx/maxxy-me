{
  "name": "maxxy-me",
  "version": "0.1.0-phase1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "cd apps/web && bun run dev",
    "dev:orchestrator": "cd apps/orchestrator && bun run dev",
    "dev:host": "cd apps/host-agent && bun run dev",
    "build": "bun run build:packages && cd apps/web && bun run build",
    "build:packages": "tsc --noEmit",
    "start:web": "cd apps/web && bun run start",
    "start:worker": "cd apps/orchestrator && bun run start",
    "start:host": "cd apps/host-agent && bun run start",
    "db:generate": "bun scripts/db-generate.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun scripts/db-seed.ts",
    "db:check": "bun scripts/db-check.ts",
    "owner:recovery-token": "bun scripts/create-owner-recovery-token.ts",
    "release": "bun scripts/release.ts",
    "phase0:check": "bun scripts/phase0-check.ts",
    "security:check": "bun scripts/security-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:e2e": "bun scripts/e2e-placeholder.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "15.4.6",
    "postgres": "3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ws": "8.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@types/bun": "1.2.21",
    "@types/node": "26.2.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/ws": "8.18.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "5.9.2"
  }
}
