# Copy to /etc/maxxy-me/production.env on the VPS. Do not commit real values.
NODE_ENV=production
APP_ENV=production
APP_NAME=maxxy-me
APP_URL=https://workspace.example.com
MAXXY_SITE_ADDRESS=workspace.example.com

POSTGRES_DB=maxxy_me
POSTGRES_USER=maxxy
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgres://maxxy:replace-with-long-random-password@postgres:5432/maxxy_me

APP_SECRET=replace-with-32-byte-random-secret
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret

LOG_LEVEL=info
LOG_FORMAT=json
RELEASE_VERSION=production
PROTOCOL_VERSION=1
APP_IMAGE_DIGEST=registry.example.com/maxxy-me@sha256:replace-with-digest
SYSTEM_WORKER_STALE_AFTER_MS=15000
SYSTEM_HOST_STALE_AFTER_MS=45000

BACKUP_STAGING_DIR=/var/lib/maxxy-me/backup-staging
BACKUP_TARGET=file:///var/lib/maxxy-me/backup-staging/offsite-placeholder
BACKUP_ENCRYPTION_KEY_FILE=/etc/maxxy-me/backup-age-recipients.txt
BACKUP_USE_COMPOSE=true
